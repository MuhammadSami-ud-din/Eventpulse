# Copy to server/.env for local development. Never commit the real .env.
# On a host, set these as environment variables instead (see DEPLOY.md).

NODE_ENV=development
PORT=4000
# Origin allowed by CORS. In development the Vite proxy makes requests same-origin.
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the app, so rate limiting sees the real
# client IP. Defaults to 1 in production (behind the host's HTTPS proxy) and 0
# otherwise. Only set it if your setup differs.
# TRUST_PROXY=1

# Public URL of the app. When set, ticket QR codes contain a link to
# <TICKET_BASE_URL>/t/<code>; when empty, they contain only the code.
TICKET_BASE_URL=

# MySQL: either one connection string...
# DATABASE_URL=mysql://user:password@host:3306/eventhub
# ...or separate settings (ignored when DATABASE_URL is set). The migrate
# script creates DB_NAME if it does not exist and the user is allowed to.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eventhub
DB_PASSWORD=change-me
DB_NAME=eventhub
DB_CONNECTION_LIMIT=10
# Set to true if your database requires TLS. DB_SSL_CA is the provider's CA
# certificate (PEM), only needed if it is not signed by a public authority.
DB_SSL=false
# DB_SSL_CA=

# Two different random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
