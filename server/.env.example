# Copy to server/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000
# Origin allowed by CORS. In development the Vite proxy makes requests same-origin.
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (e.g. 1 behind nginx), so
# rate limiting sees the real client IP. Keep 0 when running directly.
TRUST_PROXY=0

# MySQL connection. The migrate script creates DB_NAME if it does not exist,
# so DB_USER needs CREATE privileges on it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eventhub
DB_PASSWORD=change-me
DB_NAME=eventhub
DB_CONNECTION_LIMIT=10

# Two different random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
